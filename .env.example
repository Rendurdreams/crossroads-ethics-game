# Supabase Configuration
#
# LOCAL DEV (after `supabase start`):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<printed by `supabase status`>
#
# HOSTED (production / presentation day):
#   VITE_SUPABASE_URL=https://your-project.supabase.co
#   VITE_SUPABASE_ANON_KEY=your-anon-key-here

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# WARNING: Service role key must NEVER use VITE_ prefix — it would be
# exposed to the browser. For this classroom app all operations use
# the anon key with open RLS policies.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
